# 이 파일은 "어떤 환경 변수가 필요한지"만 알려 주는 예시입니다. 실제 값은 넣지 않습니다.
# - 로컬: 이 파일을 .env.local 로 복사해 값을 채웁니다. (.env.local 은 Git에 올라가지 않습니다)
# - Vercel: Project > Settings > Environment Variables 에 같은 이름으로 등록합니다.
#   로컬의 .env.local 은 Vercel에 자동으로 올라가지 않습니다.
# - NEXT_PUBLIC_ 이 붙은 값은 빌드할 때 코드에 박혀 브라우저에 공개됩니다.
#   값을 바꾸면 새로 배포(빌드)해야 반영됩니다.

NEXT_PUBLIC_TMDB_API_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=
# 브라우저가 요청할 백엔드 주소. 비워 두면 http://localhost:8080 입니다.
# 배포(HTTPS)에서 백엔드가 HTTP라면 /api/backend 로 두고 아래 BACKEND_PROXY_TARGET 을 함께 설정합니다.
NEXT_PUBLIC_BACKEND_API_BASE_URL=
# (서버 전용, NEXT_PUBLIC 아님) /api/backend/* 요청을 대신 전달할 백엔드 주소. 예: http://EC2_공개_IP:8080
BACKEND_PROXY_TARGET=
